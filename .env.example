# ── Video source ──────────────────────────────────────────────
# Single-camera fallback (used only when no NVR creds are set below).
# webcam index (0), RTSP URL, or path to a video file
VIDEO_SOURCE=0
# VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101

# ── Ollama (local VLM) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
VLM_MODEL=moondream
VLM_MODEL_HEAVY=llama3.2-vision

# ── YOLO ──────────────────────────────────────────────────────
# Auto-downloaded by ultralytics on first run.
DETECTION_MODEL=yolov8m.pt
POSE_MODEL=yolov8n-pose.pt
DETECTION_CONFIDENCE=0.25
# YOLO inference size (multiple of 32). 640 = sweet spot on CPU.
DETECTION_IMGSZ=640
# Safety cap: resize the captured frame to this width before YOLO.
# 0 = no resize. Leave at 1280 — sub-streams after upgrade_substreams.py
# come in at ≤720p, so this is effectively a no-op.
FRAME_MAX_WIDTH=1280
VLM_MAX_FPS=1

# ── NVRs for the multi-camera grid ────────────────────────────
# backend/cameras.json maps id/name -> NVR + channel; the RTSP URL is
# assembled from these creds at runtime, never committed.
HIKVISION_IP=
HIKVISION_USER=admin
HIKVISION_PASS=
NVR1_IP=
NVR1_USER=admin
NVR1_PASS=
NVR2_IP=
NVR2_USER=admin
NVR2_PASS=

# Optional whitelist: only load cameras in these rooms.
# Comma-separated room names (must match cameras.json `room`).
# Empty = load every camera whose NVR creds are set.
ENABLED_ROOMS=

# ── Engine tuning ─────────────────────────────────────────────
# Visible cameras run as fast as decode+YOLO allow (= the FPS the viewer sees,
# since render and detect are the same operation now). Non-visible cameras
# with rules are watched continuously and capped at this rate so they don't
# steal CPU from what the user is looking at.
MONITOR_FPS=1.5
# Motion gate: % of pixels that must change frame-to-frame to flag the scene
# as moving (drives the tile "live" dot and gates VLM evaluation).
MOTION_MIN_PCT=0.6

# ── Storage ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///watcher.db

# ── Notifications ─────────────────────────────────────────────
# ntfy.sh phone push — action {"type":"ntfy"}
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# Generic webhook (Discord-compatible) — action {"type":"webhook"}
WEBHOOK_URL=
# Telegram bot — action {"type":"telegram"}
# Token via @BotFather, chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via CallMeBot — action {"type":"whatsapp"}
# Free: message the bot once (callmebot.com/whatsapp) to receive an apikey.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
