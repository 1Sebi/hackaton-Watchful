# ── Video source ──────────────────────────────────────────────
# webcam index (0) or RTSP URL or path to a sample video file
VIDEO_SOURCE=0
# VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
# VIDEO_SOURCE=eval/clips/sample.mp4

# ── Ollama (local VLM) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Primary fast model used for compile + routine checks
VLM_MODEL=moondream
# Heavier, more accurate model for hard SEMANTIC conditions (angry / distressed / unattended bag)
VLM_MODEL_HEAVY=llama3.2-vision

# ── Hikvision (optional, when on-site) ────────────────────────
HIKVISION_IP=
HIKVISION_USER=admin
HIKVISION_PASS=

# ── NVRs for the multi-camera grid (backend/cameras.json maps id/name -> nvr+channel;
#    the RTSP URL is assembled from these creds at runtime, never committed) ──
NVR1_IP=
NVR1_USER=admin
NVR1_PASS=
NVR2_IP=
NVR2_USER=admin
NVR2_PASS=

# ── Multi-camera grid tuning ──────────────────────────────────
# % of pixels that must change frame-to-frame for the OpenCV motion gate to run YOLO
MOTION_MIN_PCT=0.6
# active-camera display refresh (decoupled from detection -> smooth video)
RENDER_FPS=20
# inactive grid-tile display refresh (lower saves CPU)
GRID_TILE_FPS=6
# cap how often the active camera runs YOLO (5 = five frames/sec; needed for stable
# ByteTrack ids — at 1 fps the Kalman filter drifts and tracks fragment)
DETECT_MAX_FPS=5
# the active camera auto-upgrades to its 4K main stream; this downscales it for
# fast detection + smooth render (tiles stay on the light sub-stream)
FRAME_MAX_WIDTH=1280

# ── Webhook action (optional) — ntfy.sh / Discord / generic ───
WEBHOOK_URL=

# ── ntfy.sh phone notifications (optional) ────────────────────
# A condition with action {"type":"ntfy"} pushes to NTFY_BASE_URL/NTFY_TOPIC.
# Public service: only generic alert text is sent (never footage/credentials).
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

# ── Telegram bot (action {"type":"telegram"}) ─────────────────
# 1) Create a bot: message @BotFather -> /newbot -> copy the token.
# 2) Get your chat id: message @userinfobot -> copy the number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp via CallMeBot (action {"type":"whatsapp"}) ───────
# Free: follow callmebot.com/whatsapp (message their number once) to get an apikey.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ── Continuous monitoring ─────────────────────────────────────
# Cameras with enabled rules are watched (detect+evaluate+act) at this rate even
# when not the focus camera, so a rule fires while you view another room.
MONITOR_FPS=1.5

# ── YOLO models (auto-downloaded by ultralytics) ──────────────
# CPU FPS: yolov8n ~31, yolov8s ~10-15, yolov8m ~2. Recall is model-size-bound
# on wide overhead shots — yolov8s is the balanced pick on CPU.
DETECTION_MODEL=yolov8m.pt
POSE_MODEL=yolov8n-pose.pt
DETECTION_CONFIDENCE=0.25
# YOLO inference size (multiple of 32). Bigger = small/distant people detected.
# 640 = default; 960 = recommended for overhead venue cams.
DETECTION_IMGSZ=960
# Capture a sharp high-res stream but downscale to this width before detection
# (0 = native). 1280 keeps 4K-main detail while staying CPU-real-time.
FRAME_MAX_WIDTH=0

# ── Sampling / agent loop ─────────────────────────────────────
# YOLO/Pose run fast; VLM is throttled to save compute
VLM_MAX_FPS=1
YOLO_MAX_FPS=25

# ── Storage ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///watchful.db
