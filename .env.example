# ── Video source ──────────────────────────────────────────────
# webcam index (0) or RTSP URL or path to a sample video file
VIDEO_SOURCE=0
# VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
# VIDEO_SOURCE=eval/clips/sample.mp4

# ── Ollama (local VLM) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Primary fast model used for compile + routine checks
VLM_MODEL=moondream
# Heavier, more accurate model for hard SEMANTIC conditions (angry / distressed / unattended bag)
VLM_MODEL_HEAVY=llama3.2-vision

# ── Hikvision (optional, when on-site) ────────────────────────
HIKVISION_IP=
HIKVISION_USER=admin
HIKVISION_PASS=

# ── YOLO models (auto-downloaded by ultralytics) ──────────────
DETECTION_MODEL=yolov8m.pt
POSE_MODEL=yolov8m-pose.pt
DETECTION_CONFIDENCE=0.5

# ── Sampling / agent loop ─────────────────────────────────────
# YOLO/Pose run fast; VLM is throttled to save compute
VLM_MAX_FPS=1
YOLO_MAX_FPS=25
