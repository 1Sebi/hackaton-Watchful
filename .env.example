# --- Hikvision camera / NVR (provided by the organizers) ---
CAM_IP=192.168.1.64
CAM_USER=admin
CAM_PASS=changeme
CAM_RTSP_PORT=554
# 102 = substream (smaller, faster — recommended); 101 = main stream
CAM_CHANNEL=102

# --- Vision-language model ---
ANTHROPIC_API_KEY=sk-ant-...
# fast/cheap for polling: claude-haiku-4-5  | more accurate: claude-sonnet-4-6 / claude-opus-4-8
WATCHFUL_MODEL=claude-sonnet-4-6

# --- Optional ---
WEBHOOK_URL=
CONDITIONS_PATH=conditions.yaml
